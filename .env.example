# shopify-mcp — local/dev configuration.
# In production, credentials come from datumbridge-integrations'
# POST /internal/v1/inject (vault credentials_json), not from env vars.

# Server
SHOPIFY_MCP_PORT=8013
SHOPIFY_MCP_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# Local/dev-only credential fallback (never used when credentials_json is injected by a tool call)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_SHOP=

# Optional: read credentials_path from a jailed directory instead of env
SHOPIFY_CREDENTIALS_DIR=/credentials

# Optional: narrow the full tool catalogue to an explicit allowlist (comma-separated tool names)
SHOPIFY_TOOLS=

# Optional overrides
SHOPIFY_API_VERSION=2024-04
SHOPIFY_API_BASE=
SHOPIFY_HTTP_TIMEOUT_SEC=30
